# Binaries (the CLI builds to an explicit path; the module dir is `xcrack/`, so
# never ignore a bare `xcrack` here -- that would exclude the module).
/xcrack-bin
*.exe
*.test
*.out

# `make build` writes compiled binaries here; keep the directory, ignore the
# binaries that land in it.
/bin/*
!/bin/.gitkeep

# Stray binaries left by `go build ./cmd/...` run from inside the xcrack/ module
# directory (these are files *inside* the module dir, not the dir itself).
/xcrack/xcrack
/xcrack/xcrackd

# Build / coverage
/dist/
coverage.*

# Default result-file outputs written by the example configs (config/*.yaml)
/results.json
/results.ndjson

# Editor
.idea/
.vscode/
*.swp

# Stray CLI binaries built at the module root (use `make build`, which writes to bin/).
/xcrack/xcrack-web
/xcrack/xcrackd

# Coverage profile from `make cover`
coverage.out
